{
  "name": "@crawlnd/utils",
  "version": "0.1.0",
  "description": "Crawlnd shared utilities (logger, page-seeds, Redis helpers)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
