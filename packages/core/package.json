{
  "name": "crawlnd",
  "version": "0.1.0",
  "description": "Crawlnd crawler runtime (Spider, Frontier, dispatch)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
